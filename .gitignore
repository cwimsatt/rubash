# Rust build artifacts
/target
/target-*
/target*/
**/*.rs.bk

# Editor files
*.swp
*.swo
*~
.idea/
*.iml
.vscode/
.settings/

# OS files
.DS_Store
Thumbs.db

# Log files
*.log

# Temporary files
*.tmp
*.bak
*.jsonl
# safebash test fixtures are data the harvested/brush_compat tests load; keep them tracked.
!crates/safebash/tests/data/*.jsonl

*.out
*.diff

# Environment files
.env
.env.local

# Original bash source (not part of this project)
/bash/

# Generated documentation
doc/

# Release builds (keep source)
/release/
.cargo/

agents.md

.tmpwork/
.zcodeignore

# regression GNU goldens: *.gnu.out must not be swallowed by the *.out rule
!tests/regression/golden/**
